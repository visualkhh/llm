<?xml version="1.0"?>
<!--
  biped.urdf — 2족보행 휴머노이드 로봇의 "순수한" 물리적 정의

  이 파일에는 일부러 액추에이터(모터)를 넣지 않았다. URDF는 로봇공학
  생태계(ROS 등)에서 두루 쓰이는 표준 포맷이며, 원래 목적은 "이 로봇의
  뼈대(link)와 관절(joint)이 어떻게 생겼고 어떻게 움직이는가"를 기술하는
  것이지 "어떤 시뮬레이터에서 어떻게 제어할 것인가"까지 담는 것이 아니다.
  그래서 모터/제어 방식은 이 파일이 아니라 파이썬 쪽(envs/biped_env.py)에서
  MuJoCo의 MjSpec API로 이 URDF를 불러온 뒤 동적으로 붙인다.
  (자세한 이유와 실험 과정은 documents/01-urdf-and-mujoco.md 참고)

  좌표계 규칙(URDF/ROS 표준): x = 정면(앞), y = 왼쪽, z = 위
  즉 로봇이 "앞으로 걷는다"는 것은 +x 방향으로 이동한다는 뜻이다.

  전체 뼈대 구조 (트리 구조):

    world (가상의 고정점, 실체 없음)
      └─ torso = 골반/하체 몸통 (자유 부유 베이스, floating joint)
           ├─ chest (revolute, y축=waist)         ─ 가슴/상체 (허리 관절로 연결)
           │    ├─ head (revolute, y축=neck)       ─ 머리 (목 관절로 끄덕임)
           │    ├─ l_upper_arm(shoulder) ─ l_lower_arm(elbow)  ─ 왼팔 (회전 관절, 액추에이터는 없음=수동)
           │    └─ r_upper_arm(shoulder) ─ r_lower_arm(elbow)  ─ 오른팔
           ├─ l_hip_yaw_link (revolute, z축=hip_yaw)   ┐
           │    └─ l_hip_roll_link (revolute, x축=hip_roll) │
           │         └─ l_thigh (revolute, y축=hip_pitch)   │ 왼쪽 다리
           │              └─ l_shin (revolute, y축=knee)    │ (실제로 강화학습이
           │                   └─ l_foot (revolute, y축=ankle) │ 제어하는 5개 관절)
           └─ r_hip_yaw_link ... (오른쪽 다리, 왼쪽과 동일 구조 좌우 대칭)

  다리 하나당 5개의 회전 관절(hip_yaw, hip_roll, hip_pitch, knee, ankle) ×
  2다리 = 10개. 이 10개만 envs/biped_env.py에서 모터(액추에이터)가 붙어
  강화학습이 직접 "제어"하는 대상이다.
    - hip_yaw   : 다리를 좌우로 회전(방향 전환/조향에 필요)
    - hip_roll  : 다리를 옆으로 벌리고 오므림(외전/내전, 좌우 균형 잡기에 중요)
    - hip_pitch : 다리를 앞뒤로 흔듦(걷는 동작의 핵심)
    - knee      : 무릎을 굽힘(사람 무릎처럼 한쪽 방향으로만 굽혀지도록 제한)
    - ankle     : 발목을 앞뒤로 젖힘(지면을 밀어내는 추진력, 균형 유지)

  고관절(hip)이 yaw+roll+pitch 3축을 모두 갖춰 사람 고관절(볼 조인트)에
  더 가까워졌다. 반대로 어깨(shoulder)는 아직 1축(pitch)뿐이고 목(neck)도
  1축(pitch)뿐이라 완전한 볼 조인트는 아니다 (필요하면 hip_roll과 같은
  방식으로 축을 더 추가할 수 있음).

  waist(허리)/neck(목)/shoulder(어깨)/elbow(팔꿈치)는 전부 "관절은 있지만
  모터는 없는" 수동(passive) 관절이다. 완전히 뻣뻣하게 고정(fixed)해두면
  걸을 때 몸통이 마치 통나무처럼 움직여 부자연스럽고, 로봇이 순간적으로
  받는 충격(발이 땅에 닿을 때 등)을 흡수할 방법도 없다. 각 관절에 넣은
  <dynamics damping="..."/> 값이 "관성으로 흔들리되 서서히 원래 자세로
  가라앉는" 스프링-댐퍼 같은 물리적 거동을 만들어, 액추에이터 없이도
  걸을 때 팔이 자연스럽게 흔들리고 상체가 약간 흔들리는 효과를 낸다.
  (강화학습의 행동 공간에는 포함되지 않으므로 학습 난이도에는 영향을
  주지 않으면서, 로봇의 외형/물리적 사실감만 높여준다.)

  질량/관성값은 정밀한 인체측정 데이터가 아니라 각 몸통 부위를 단순한
  상자/구로 근사해 계산한 값이다 (교육/실험 목적에는 충분하지만 실제
  로봇 설계에 쓸 수준의 정밀도는 아니다).
-->
<robot name="biped">

  <!-- ===================== 가상 고정점 ===================== -->
  <!-- world는 실제 형상이 없는 "빈 링크"로, floating joint의 부모로만 쓰인다.
       URDF 표준 자체에는 "자유롭게 움직이는 베이스"라는 개념이 없어서
       (원래는 팔 같은 고정 베이스 로봇을 기술하기 위한 포맷이었음), MuJoCo가
       확장해서 지원하는 type="floating" 조인트를 이용해 흉내낸다. -->
  <link name="world"/>

  <!-- ===================== 몸통(torso) ===================== -->
  <joint name="root_joint" type="floating">
    <parent link="world"/>
    <child link="torso"/>
  </joint>

  <link name="torso">
    <!-- 위치(x,y,z 3개) + 방향(3개, 회전) = 6 자유도. 즉 이 로봇은 하늘을
         날 수도, 옆으로 넘어질 수도 있는 "완전히 자유로운" 몸통을 가지며,
         쓰러지지 않고 두 발로 서서 걷는 것 자체를 스스로 학습해야 한다.

         이 링크는 골반(하체 몸통)에 해당하며, 다리가 여기 붙는다. 원래는
         가슴 부분까지 포함한 몸통 전체가 이 박스 하나였는데, 허리 관절을
         표현하기 위해 골반(torso)과 가슴(chest) 두 링크로 나눴다. -->
    <inertial>
      <mass value="7"/>
      <inertia ixx="0.06907" ixy="0" ixz="0" iyy="0.05693" iyz="0" izz="0.07933"/>
    </inertial>
    <visual>
      <geometry><box size="0.24 0.28 0.2"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.24 0.28 0.2"/></geometry>
    </collision>
  </link>

  <!-- ===================== 가슴(상체) — 허리 관절로 골반과 연결 ===================== -->
  <joint name="waist_joint" type="revolute">
    <parent link="torso"/>
    <child link="chest"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 1 0"/>
    <!-- 허리를 앞뒤로 굽히는 각도. 사람도 서 있을 때 허리를 크게 꺾지는
         않으므로 범위를 좁게(±23도) 잡았다. 액추에이터가 없는 수동
         관절이라 damping으로 "천천히 원위치로 돌아오는" 성질을 준다. -->
    <limit lower="-0.4" upper="0.4" effort="40" velocity="4"/>
    <dynamics damping="8.0" friction="0.5"/>
  </joint>
  <link name="chest">
    <inertial>
      <origin xyz="0 0 0.16"/>
      <mass value="11"/>
      <inertia ixx="0.1657" ixy="0" ixz="0" iyy="0.1467" iyz="0" izz="0.1247"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.16"/>
      <geometry><box size="0.24 0.28 0.32"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.16"/>
      <geometry><box size="0.24 0.28 0.32"/></geometry>
    </collision>
  </link>

  <!-- ===================== 머리 — 목 관절로 가슴과 연결 ===================== -->
  <joint name="neck_joint" type="revolute">
    <parent link="chest"/>
    <child link="head"/>
    <origin xyz="0 0 0.32"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.5" effort="10" velocity="4"/>
    <dynamics damping="1.0" friction="0.05"/>
  </joint>
  <link name="head">
    <inertial>
      <origin xyz="0 0 0.09"/>
      <mass value="3"/>
      <inertia ixx="0.00972" ixy="0" ixz="0" iyy="0.00972" iyz="0" izz="0.00972"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.09"/>
      <geometry><sphere radius="0.09"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.09"/>
      <geometry><sphere radius="0.09"/></geometry>
    </collision>
  </link>

  <!-- ===================== 왼팔 — 어깨(2축)/팔꿈치 모두 회전 관절(수동) ===================== -->
  <joint name="l_shoulder_roll_joint" type="revolute">
    <parent link="chest"/>
    <child link="l_shoulder_roll_link"/>
    <origin xyz="0 0.16 0.22"/>
    <!-- 팔을 옆으로 벌리고 오므리는 축(외전/내전). 고관절의 hip_roll과
         같은 축(x축, 정면 방향)이라 원리도 동일하다. -->
    <axis xyz="1 0 0"/>
    <limit lower="-0.2" upper="1.5" effort="15" velocity="6"/>
    <dynamics damping="1.5" friction="0.05"/>
  </joint>
  <link name="l_shoulder_roll_link">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00008"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.03"/></geometry>
    </visual>
    <collision>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
  </link>

  <joint name="l_shoulder_pitch_joint" type="revolute">
    <parent link="l_shoulder_roll_link"/>
    <child link="l_upper_arm"/>
    <!-- 앞뒤로 흔드는 축(사람이 걸을 때 팔을 앞뒤로 흔드는 것과 같은 축) -->
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="15" velocity="6"/>
    <dynamics damping="1.5" friction="0.05"/>
  </joint>
  <link name="l_upper_arm">
    <inertial>
      <origin xyz="0 0 -0.14"/>
      <mass value="2"/>
      <inertia ixx="0.013667" ixy="0" ixz="0" iyy="0.013667" iyz="0" izz="0.0012"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.14"/>
      <geometry><box size="0.06 0.06 0.28"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.14"/>
      <geometry><box size="0.06 0.06 0.28"/></geometry>
    </collision>
  </link>

  <joint name="l_elbow_joint" type="revolute">
    <parent link="l_upper_arm"/>
    <child link="l_lower_arm"/>
    <origin xyz="0 0 -0.28"/>
    <!-- 축과 부호를 시뮬레이션으로 직접 검증: axis="0 -1 0"일 때
         양수 각도가 팔을 앞으로(+x) 굽힌다는 것을 확인하고 정함. -->
    <axis xyz="0 -1 0"/>
    <!-- 0=팔을 곧게 편 상태, 양수=팔꿈치를 굽힌 상태(앞으로 접힘) -->
    <limit lower="0" upper="2.0" effort="10" velocity="6"/>
    <dynamics damping="1.0" friction="0.05"/>
  </joint>
  <link name="l_lower_arm">
    <inertial>
      <origin xyz="0 0 -0.125"/>
      <mass value="1.5"/>
      <inertia ixx="0.008125" ixy="0" ixz="0" iyy="0.008125" iyz="0" izz="0.000625"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.125"/>
      <geometry><box size="0.05 0.05 0.25"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.125"/>
      <geometry><box size="0.05 0.05 0.25"/></geometry>
    </collision>
  </link>

  <!-- ===================== 오른팔 (왼팔과 좌우 대칭, y부호만 반대) ===================== -->
  <joint name="r_shoulder_roll_joint" type="revolute">
    <parent link="chest"/>
    <child link="r_shoulder_roll_link"/>
    <origin xyz="0 -0.16 0.22"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="0.2" effort="15" velocity="6"/>
    <dynamics damping="1.5" friction="0.05"/>
  </joint>
  <link name="r_shoulder_roll_link">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00008"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.03"/></geometry>
    </visual>
    <collision>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
  </link>

  <joint name="r_shoulder_pitch_joint" type="revolute">
    <parent link="r_shoulder_roll_link"/>
    <child link="r_upper_arm"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="15" velocity="6"/>
    <dynamics damping="1.5" friction="0.05"/>
  </joint>
  <link name="r_upper_arm">
    <inertial>
      <origin xyz="0 0 -0.14"/>
      <mass value="2"/>
      <inertia ixx="0.013667" ixy="0" ixz="0" iyy="0.013667" iyz="0" izz="0.0012"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.14"/>
      <geometry><box size="0.06 0.06 0.28"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.14"/>
      <geometry><box size="0.06 0.06 0.28"/></geometry>
    </collision>
  </link>

  <joint name="r_elbow_joint" type="revolute">
    <parent link="r_upper_arm"/>
    <child link="r_lower_arm"/>
    <origin xyz="0 0 -0.28"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.0" effort="10" velocity="6"/>
    <dynamics damping="1.0" friction="0.05"/>
  </joint>
  <link name="r_lower_arm">
    <inertial>
      <origin xyz="0 0 -0.125"/>
      <mass value="1.5"/>
      <inertia ixx="0.008125" ixy="0" ixz="0" iyy="0.008125" iyz="0" izz="0.000625"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.125"/>
      <geometry><box size="0.05 0.05 0.25"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.125"/>
      <geometry><box size="0.05 0.05 0.25"/></geometry>
    </collision>
  </link>

  <!-- =============================================================
       왼쪽 다리 — 이 프로젝트의 핵심. 강화학습이 실제로 제어하는 5관절.
       torso -> (hip_yaw) -> l_hip_yaw_link -> (hip_roll) -> l_hip_roll_link
             -> (hip_pitch) -> l_thigh -> (knee) -> l_shin -> (ankle) -> l_foot

       hip_yaw/hip_roll/hip_pitch를 세 개의 별도 조인트로 나눈 이유: URDF의
       조인트는 하나당 회전축 1개(1자유도)만 가질 수 있어서, 사람 고관절
       (공처럼 여러 방향으로 도는 볼 조인트, 3자유도: 좌우 회전+옆으로
       벌림/오므림+앞뒤 흔들기)을 표현하려면 그 사이사이에 질량이 거의
       없는 가상의 중간 링크(l_hip_yaw_link, l_hip_roll_link)를 끼워 넣어,
       세 개의 1자유도 조인트를 연달아 연결해야 한다.
       ============================================================= -->

  <joint name="l_hip_yaw_joint" type="revolute">
    <parent link="torso"/>
    <child link="l_hip_yaw_link"/>
    <origin xyz="0 0.12 -0.1"/>
    <axis xyz="0 0 1"/>
    <!-- 좌우 ±28.6도. 방향 전환(조향)에 쓰이는 관절이라 너무 크게 열어두면
         다리가 서로 꼬이거나 비현실적인 자세가 나올 수 있어 범위를 좁게 잡음 -->
    <limit lower="-0.5" upper="0.5" effort="60" velocity="6"/>
  </joint>
  <link name="l_hip_yaw_link">
    <!-- 실제 부피가 있는 부위가 아니라 두 조인트를 잇기 위한 가상의 관절
         뭉치이므로 질량을 아주 작게 준다 (0으로 두면 물리엔진이
         불안정해질 수 있어 완전히 0은 피한다). -->
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.000108" ixy="0" ixz="0" iyy="0.000108" iyz="0" izz="0.000108"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.03"/></geometry>
    </visual>
    <collision>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
  </link>

  <joint name="l_hip_roll_joint" type="revolute">
    <parent link="l_hip_yaw_link"/>
    <child link="l_hip_roll_link"/>
    <!-- 다리를 옆으로 벌리고 오므리는 축(외전/내전, abduction/adduction).
         사람 골반이 x축(정면 방향)을 중심으로 회전하는 것과 같은 축이라
         axis를 "1 0 0"으로 둔다. -->
    <axis xyz="1 0 0"/>
    <limit lower="-0.35" upper="0.35" effort="80" velocity="6"/>
  </joint>
  <link name="l_hip_roll_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.000108" ixy="0" ixz="0" iyy="0.000108" iyz="0" izz="0.000108"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.03"/></geometry>
    </visual>
    <collision>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
  </link>

  <joint name="l_hip_pitch_joint" type="revolute">
    <parent link="l_hip_roll_link"/>
    <child link="l_thigh"/>
    <axis xyz="0 1 0"/>
    <!-- 앞으로 크게(다리 들어올리기), 뒤로는 조금만(사람 고관절과 비슷하게) -->
    <limit lower="-1.57" upper="0.79" effort="120" velocity="8"/>
  </joint>
  <link name="l_thigh">
    <inertial>
      <origin xyz="0 0 -0.175"/>
      <mass value="7"/>
      <inertia ixx="0.07986" ixy="0" ixz="0" iyy="0.07986" iyz="0" izz="0.0168"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.175"/>
      <geometry><box size="0.12 0.12 0.35"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.175"/>
      <geometry><box size="0.12 0.12 0.35"/></geometry>
    </collision>
  </link>

  <joint name="l_knee_joint" type="revolute">
    <parent link="l_thigh"/>
    <child link="l_shin"/>
    <origin xyz="0 0 -0.35"/>
    <!-- axis를 hip_pitch/ankle과 반대 방향(0 -1 0)으로 둔 이유: 사람 무릎은
         굽힐 때 발이 몸통 뒤쪽으로 접혀야 하는데, 다른 관절과 같은 축
         방향(0 1 0)을 쓰면 반대로(앞으로) 접히는 조류 다리 같은 모양이
         나온다는 것을 시뮬레이션으로 직접 확인하고 수정함. -->
    <axis xyz="0 -1 0"/>
    <!-- 사람 무릎처럼 한쪽으로만 굽혀지게 제한: 0=다리를 곧게 편 상태,
         음수=무릎을 굽힌 상태(뒤로 접힘). 양수(반대쪽으로 꺾임)는 허용하지 않는다. -->
    <limit lower="-2.3" upper="0" effort="120" velocity="8"/>
  </joint>
  <link name="l_shin">
    <inertial>
      <origin xyz="0 0 -0.175"/>
      <mass value="4"/>
      <inertia ixx="0.04417" ixy="0" ixz="0" iyy="0.04417" iyz="0" izz="0.006667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.175"/>
      <geometry><box size="0.1 0.1 0.35"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.175"/>
      <geometry><box size="0.1 0.1 0.35"/></geometry>
    </collision>
  </link>

  <joint name="l_ankle_joint" type="revolute">
    <parent link="l_shin"/>
    <child link="l_foot"/>
    <origin xyz="0 0 -0.35"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.6" effort="80" velocity="8"/>
  </joint>
  <link name="l_foot">
    <!-- x축으로 0.06만큼 앞으로 옮겨서 발목 관절이 발의 뒤쪽(발뒤꿈치 근처)에
         오고, 발 앞부분(발가락 쪽)이 더 길게 앞으로 나오도록 함
         -> 걸을 때 발끝으로 지면을 밀어내는 지지면을 더 넓게 확보 -->
    <inertial>
      <origin xyz="0.06 0 -0.055"/>
      <mass value="1.2"/>
      <inertia ixx="0.00125" ixy="0" ixz="0" iyy="0.00509" iyz="0" izz="0.00584"/>
    </inertial>
    <visual>
      <origin xyz="0.06 0 -0.055"/>
      <geometry><box size="0.22 0.1 0.05"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.06 0 -0.055"/>
      <geometry><box size="0.22 0.1 0.05"/></geometry>
    </collision>
  </link>

  <!-- =============================================================
       오른쪽 다리 — 왼쪽 다리와 완전히 동일한 구조, y좌표 부호만 반대
       ============================================================= -->

  <joint name="r_hip_yaw_joint" type="revolute">
    <parent link="torso"/>
    <child link="r_hip_yaw_link"/>
    <origin xyz="0 -0.12 -0.1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="60" velocity="6"/>
  </joint>
  <link name="r_hip_yaw_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.000108" ixy="0" ixz="0" iyy="0.000108" iyz="0" izz="0.000108"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.03"/></geometry>
    </visual>
    <collision>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
  </link>

  <joint name="r_hip_roll_joint" type="revolute">
    <parent link="r_hip_yaw_link"/>
    <child link="r_hip_roll_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.35" upper="0.35" effort="80" velocity="6"/>
  </joint>
  <link name="r_hip_roll_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.000108" ixy="0" ixz="0" iyy="0.000108" iyz="0" izz="0.000108"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.03"/></geometry>
    </visual>
    <collision>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
  </link>

  <joint name="r_hip_pitch_joint" type="revolute">
    <parent link="r_hip_roll_link"/>
    <child link="r_thigh"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="0.79" effort="120" velocity="8"/>
  </joint>
  <link name="r_thigh">
    <inertial>
      <origin xyz="0 0 -0.175"/>
      <mass value="7"/>
      <inertia ixx="0.07986" ixy="0" ixz="0" iyy="0.07986" iyz="0" izz="0.0168"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.175"/>
      <geometry><box size="0.12 0.12 0.35"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.175"/>
      <geometry><box size="0.12 0.12 0.35"/></geometry>
    </collision>
  </link>

  <joint name="r_knee_joint" type="revolute">
    <parent link="r_thigh"/>
    <child link="r_shin"/>
    <origin xyz="0 0 -0.35"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.3" upper="0" effort="120" velocity="8"/>
  </joint>
  <link name="r_shin">
    <inertial>
      <origin xyz="0 0 -0.175"/>
      <mass value="4"/>
      <inertia ixx="0.04417" ixy="0" ixz="0" iyy="0.04417" iyz="0" izz="0.006667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.175"/>
      <geometry><box size="0.1 0.1 0.35"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.175"/>
      <geometry><box size="0.1 0.1 0.35"/></geometry>
    </collision>
  </link>

  <joint name="r_ankle_joint" type="revolute">
    <parent link="r_shin"/>
    <child link="r_foot"/>
    <origin xyz="0 0 -0.35"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.6" effort="80" velocity="8"/>
  </joint>
  <link name="r_foot">
    <inertial>
      <origin xyz="0.06 0 -0.055"/>
      <mass value="1.2"/>
      <inertia ixx="0.00125" ixy="0" ixz="0" iyy="0.00509" iyz="0" izz="0.00584"/>
    </inertial>
    <visual>
      <origin xyz="0.06 0 -0.055"/>
      <geometry><box size="0.22 0.1 0.05"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.06 0 -0.055"/>
      <geometry><box size="0.22 0.1 0.05"/></geometry>
    </collision>
  </link>

</robot>
